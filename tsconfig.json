{
  "compilerOptions": {
    "paths": {
      "@/*": ["./packages/storybranch/src/*"]
    },
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["bun"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "exclude": ["**/*.test.ts"],
  "include": [
    "packages/storybranch/src/**/*.ts",
    "packages/storybranch/src/**/*.tsx",
    "apps/review-ui/**/*.ts",
    "apps/review-ui/**/*.tsx",
    "fixture/**/*.ts",
    "fixture/**/*.tsx",
    "oxlint.config.ts",
    "oxfmt.config.ts"
  ]
}
