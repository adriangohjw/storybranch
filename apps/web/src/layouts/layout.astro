---
import "../styles/global.css";
import { AppToaster } from "../components/app-toaster.tsx";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "storybranch — local visual diffs for Storybook",
  description = "Capture Storybook stories as PNGs in Chrome, Firefox, and Edge, diff them locally, and accept baselines in a review UI.",
} = Astro.props;

const siteUrl = Astro.site?.href ?? "https://storybook.adriangohjw.com/";
const ogImage = new URL("/images/review-pixel-diff.png", siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta
      property="og:image:alt"
      content="storybranch review comparing a baseline and a pixel diff"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;700;800&family=Figtree:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh">
    <slot />
    <AppToaster client:load />
  </body>
</html>
