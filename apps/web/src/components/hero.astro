---
import CopyCommand from "./copy-command.astro";
import TerminalDemo from "./terminal-demo.astro";

const github = "https://github.com/adriangohjw/storybranch";

const setup =
  "git clone https://github.com/adriangohjw/storybranch.git && cd storybranch && bun install && bunx playwright install chromium && bun run build";

const run =
  "bun /path/to/storybranch/apps/cli/src/cli.ts test --url http://127.0.0.1:6006";
---

<section class="mx-auto grid w-full max-w-6xl gap-10 px-5 pb-16 pt-6 sm:px-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-center lg:gap-12 lg:pb-24 lg:pt-10">
  <div>
    <div class="animate-rise flex flex-wrap items-center gap-3">
      <p class="font-syne text-4xl font-extrabold tracking-tight text-ink sm:text-5xl lg:text-6xl">
        storybranch
      </p>
      <span
        class="rounded-full border border-accent/25 bg-accent/10 px-2.5 py-0.5 text-xs font-semibold tracking-wide text-accent uppercase"
      >
        Alpha
      </span>
    </div>
    <h1 class="animate-rise-delay-1 mt-4 max-w-xl text-2xl font-semibold leading-snug text-ink sm:text-3xl">
      Local visual diffs for Storybook
    </h1>
    <p class="animate-rise-delay-2 mt-4 max-w-md text-base leading-relaxed text-ink-muted sm:text-lg">
      Capture stories as PNGs, pixel-diff against baselines on disk, and accept changes in a browser review UI — no cloud required.
    </p>
    <div class="animate-rise-delay-3 mt-8 flex flex-wrap items-center gap-3">
      <a
        href="#review"
        class="rounded-md bg-accent px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-deep"
      >
        See a review
      </a>
      <a
        href={github}
        class="rounded-md border border-ink/15 bg-surface/80 px-4 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-ink/30"
        rel="noopener noreferrer"
        target="_blank"
      >
        View on GitHub
      </a>
    </div>
    <div class="animate-rise-delay-3 mt-6 max-w-xl space-y-3">
      <p class="text-xs font-medium tracking-wide text-ink-muted uppercase">
        The package is not on npm yet
      </p>
      <CopyCommand command={setup} />
      <p class="text-xs leading-relaxed text-ink-muted">
        Then, from your app, with Storybook 10+ already running:
      </p>
      <CopyCommand command={run} />
      <p class="text-xs leading-relaxed text-ink-muted">
        After publish, install with{" "}
        <code class="font-mono text-ink">bun add -d storybranch</code>, then that second command is{" "}
        <code class="font-mono text-ink">bunx storybranch test --url http://127.0.0.1:6006</code>.
      </p>
    </div>
  </div>
  <div class="animate-rise-delay-2 min-w-0">
    <TerminalDemo />
  </div>
</section>
