---
import { LuCheck } from "react-icons/lu";

const shots = [
  {
    actual: "/images/demo/actual-copy.svg",
    baseline: "/images/demo/baseline.svg",
    diff: "/images/demo/diff-copy.svg",
    aspect: "800 / 300",
    id: "hero--default__1200x900.png",
    label: "hero--default__1200x900.png",
    status: "changed" as const,
    storyId: "hero--default",
  },
  {
    actual: "/images/demo/actual-narrow-added.svg",
    baseline: "/images/demo/baseline-narrow.svg",
    diff: "/images/demo/diff-narrow-added.svg",
    aspect: "320 / 420",
    id: "hero--modes__narrow.png",
    label: "hero--modes__narrow.png",
    status: "changed" as const,
    storyId: "hero--modes",
  },
  {
    actual: "/images/demo/actual-wide.svg",
    baseline: "/images/demo/baseline-wide.svg",
    diff: "/images/demo/diff-wide.svg",
    aspect: "800 / 300",
    id: "hero--modes__wide.png",
    label: "hero--modes__wide.png",
    status: "changed" as const,
    storyId: "hero--modes",
  },
  {
    actual: "/images/demo/actual-new.svg",
    baseline: null,
    diff: null,
    aspect: "320 / 420",
    id: "hero--pinned__mobile1.png",
    label: "hero--pinned__mobile1.png",
    status: "new" as const,
    storyId: "hero--pinned",
  },
  {
    actual: "/images/demo/baseline.svg",
    baseline: "/images/demo/baseline.svg",
    diff: null,
    aspect: "800 / 300",
    id: "hero--skipped__1200x900.png",
    label: "hero--skipped__1200x900.png",
    status: "unchanged" as const,
    storyId: "hero--skipped",
  },
];

const groups = Map.groupBy(shots, (shot) => shot.storyId);

const badgeClass = {
  changed: "bg-amber-500/20 text-amber-300",
  new: "bg-sky-500/20 text-sky-300",
  unchanged: "bg-emerald-500/20 text-emerald-300",
} as const;

const initialId = "hero--default__1200x900.png";
---

<section class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8 sm:py-20" id="review">
  <div class="max-w-2xl">
    <h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      Review changes in the browser
    </h2>
    <p class="mt-3 text-base text-ink-muted sm:text-lg">
      When something drifts, storybranch serves a local UI to compare baseline vs this scan (with an optional diff overlay) and accept updates.
    </p>
  </div>

  <div
    class="review-demo mt-10 overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950 text-zinc-100 shadow-[0_24px_60px_-28px_rgb(0_0_0_/_0.55)]"
    data-review-demo
  >
    <header class="border-b border-zinc-800 px-5 py-4">
      <h3 class="text-lg font-semibold tracking-tight">storybranch review</h3>
      <p class="mt-1 text-sm text-zinc-400">
        commit a589471 · <span data-shot-count>{shots.length}</span> snapshots
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <label class="flex items-center gap-2 text-sm text-zinc-300">
          Filter
          <select
            class="rounded-md border border-zinc-700 bg-zinc-900 px-2 py-1 text-sm text-zinc-100"
            data-filter
          >
            <option value="all" selected>All</option>
            <option value="attention">Needs attention</option>
            <option value="changed">Changed</option>
            <option value="new">New</option>
            <option value="unchanged">Unchanged</option>
          </select>
        </label>
        <button
          class="rounded-md bg-zinc-100 px-3 py-1.5 text-sm font-medium text-zinc-900 hover:bg-white"
          data-accept-all
          type="button"
        >
          Accept all
        </button>
      </div>
    </header>

    <div class="grid min-h-[22rem] grid-cols-1 lg:grid-cols-[minmax(14rem,18rem)_1fr]" data-main>
      <aside class="flex flex-col border-b border-zinc-800 lg:border-r lg:border-b-0" data-aside>
        <div class="flex shrink-0 items-center justify-between gap-2 border-b border-zinc-800 px-2 py-1.5">
          <span class="truncate text-xs font-medium text-zinc-400" data-aside-label>
            Snapshots
          </span>
          <button
            aria-label="Collapse snapshot list"
            class="rounded p-1 text-zinc-400 hover:bg-zinc-800 hover:text-zinc-200"
            data-collapse
            type="button"
          >
            <span aria-hidden class="block text-sm leading-none">⟨</span>
          </button>
        </div>
        <div class="min-h-0 flex-1 overflow-auto p-2" data-shot-list>
          {
            [...groups.entries()].map(([storyId, storyShots]) => (
              <section class="mb-4" data-story-group data-story={storyId}>
                <h4 class="mb-1 text-xs font-semibold tracking-wide text-zinc-500 uppercase">
                  {storyId}
                </h4>
                <ul class="space-y-1">
                  {storyShots.map((shot) => (
                    <li class="flex items-center gap-0.5" data-shot-row data-status={shot.status} data-id={shot.id}>
                      <button
                        class:list={[
                          "flex min-w-0 flex-1 flex-col items-start gap-1 rounded-md border px-2 py-1.5 text-left transition-colors",
                          "hover:border-zinc-600 hover:bg-zinc-800/80",
                          shot.id === initialId
                            ? "border-zinc-500 bg-zinc-800"
                            : "border-transparent",
                        ]}
                        data-select
                        data-id={shot.id}
                        data-baseline={shot.baseline ?? ""}
                        data-actual={shot.actual}
                        data-diff={shot.diff ?? ""}
                        data-aspect={shot.aspect}
                        data-status={shot.status}
                        type="button"
                      >
                        <span
                          class:list={[
                            "rounded-full px-1.5 py-px text-[9px] leading-none font-semibold tracking-wide uppercase",
                            badgeClass[shot.status],
                          ]}
                        >
                          {shot.status}
                        </span>
                        <span class="text-xs leading-snug break-all text-zinc-200">{shot.label}</span>
                      </button>
                      {shot.status !== "unchanged" ? (
                        <button
                          aria-label="Accept"
                          class="shrink-0 rounded p-1 text-zinc-300 hover:bg-zinc-800 hover:text-white"
                          data-accept
                          data-id={shot.id}
                          type="button"
                        >
                          <LuCheck aria-hidden className="size-3.5" />
                        </button>
                      ) : null}
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </aside>

      <div class="min-w-0 overflow-auto p-4" data-viewer>
        <div class="grid gap-4 lg:grid-cols-2">
          <figure class="m-0">
            <figcaption class="mb-1 text-xs text-zinc-500">Baseline</figcaption>
            <p class="hidden text-xs text-zinc-600" data-no-baseline>No baseline</p>
            <div
              class="relative w-full overflow-hidden rounded border border-zinc-800 bg-zinc-900/50"
              data-baseline-frame
              style="aspect-ratio: 800 / 300"
            >
              <img
                alt="baseline"
                class="absolute inset-0 size-full object-contain"
                data-baseline-img
                src="/images/demo/baseline.svg"
              />
            </div>
          </figure>
          <figure class="m-0">
            <div class="mb-1 flex flex-wrap items-center justify-between gap-2">
              <figcaption class="text-xs text-zinc-500">This scan</figcaption>
              <div class="flex items-center gap-2 text-xs text-zinc-400" data-diff-controls>
                <span>Diff overlay</span>
                <button
                  aria-label="Toggle diff overlay"
                  aria-pressed="true"
                  class="relative h-5 w-9 rounded-full bg-sky-600 transition-colors"
                  data-diff-toggle
                  type="button"
                >
                  <span
                    class="absolute top-0.5 left-0.5 size-4 translate-x-4 rounded-full bg-white transition-transform"
                    data-diff-knob
                  ></span>
                </button>
              </div>
            </div>
            <div
              class="relative w-full overflow-hidden rounded border border-zinc-800 bg-zinc-900/50"
              data-preview-frame
              style="aspect-ratio: 800 / 300"
            >
              <img
                alt="this scan"
                class="absolute inset-0 size-full object-contain"
                data-actual-img
                src="/images/demo/actual-copy.svg"
              />
              <img
                alt=""
                aria-hidden
                class="pointer-events-none absolute inset-0 size-full object-contain opacity-85 mix-blend-screen"
                data-diff-img
                src="/images/demo/diff-copy.svg"
              />
            </div>
          </figure>
        </div>
        <p class="mt-4 hidden text-sm text-emerald-400" data-accepted-msg></p>
      </div>
    </div>
  </div>
</section>

<script>
  import "../lib/review-demo.ts";
</script>
