---
const github = "https://github.com/adriangohjw/storybranch";
const site = "https://adriangohjw.com";
---

<footer class="mx-auto flex w-full max-w-6xl flex-col gap-3 border-t border-ink/10 px-5 py-10 text-sm text-ink-muted sm:flex-row sm:items-center sm:justify-between sm:px-8">
  <p>
    <span class="font-syne font-bold text-ink">storybranch</span>
    {" "}· MIT licensed
  </p>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-5">
    <a
      href={github}
      class="transition-colors hover:text-ink"
      rel="noopener noreferrer"
      target="_blank"
    >
      github.com/adriangohjw/storybranch
    </a>
    <a
      href={site}
      class="transition-colors hover:text-ink"
      rel="noopener noreferrer"
      target="_blank"
    >
      adriangohjw.com
    </a>
  </div>
</footer>
