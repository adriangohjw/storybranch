---
const body = [
  `<span class="text-white"><span class="text-moss">$</span> storybranch test --url http://127.0.0.1:6006</span>`,
  `<span class="text-[#7dd3c0]">storybranch review at http://127.0.0.1:4321</span>`,
  `<span class="text-warn">missing baseline button--default__1200x900.png</span>`,
  `<span class="text-bad">pixels button--modes__narrow.png</span>`,
].join("\n");
---

<div
  class="min-w-0 overflow-hidden rounded-xl border border-ink/15 bg-terminal text-left shadow-[0_24px_60px_-28px_rgb(20_24_31_/_0.55)]"
  aria-label="Example storybranch test output"
>
  <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2.5">
    <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
    <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
    <span class="size-2.5 rounded-full bg-[#28c840]"></span>
    <span class="ml-3 font-mono text-[11px] text-white/45">~/my-app — storybranch</span>
  </div>
  <pre
    class="m-0 max-w-full overflow-x-auto p-4 font-mono text-[12px] leading-5 text-white sm:text-[13px] sm:leading-6"
    set:html={body}
  />
</div>
