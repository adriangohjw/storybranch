---
import CopyCommand from "./copy-command.astro";

const github = "https://github.com/adriangohjw/storybranch";

const install =
  "bun add -d @adriangohjw/storybranch && bunx playwright install chromium";

const test = "bunx storybranch test --url http://127.0.0.1:6006";

const setup =
  "git clone https://github.com/adriangohjw/storybranch.git && cd storybranch && bun install && bunx playwright install chromium && bun run build";

const run =
  "bun /path/to/storybranch/apps/cli/src/cli.ts test --url http://127.0.0.1:6006";
---

<section class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8 sm:py-24" id="install">
  <div class="rounded-2xl border border-ink/10 bg-ink px-6 py-10 text-paper sm:px-10 sm:py-14">
    <h2 class="font-syne text-3xl font-bold tracking-tight sm:text-4xl">
      Install @adriangohjw/storybranch
    </h2>
    <p class="mt-3 max-w-xl text-base text-paper/70 sm:text-lg">
      Add the CLI to your Storybook app, install Chromium for Playwright, then point <code class="font-mono text-paper/90">test</code> at a running Storybook 10+ URL.
    </p>
    <div class="mt-8 flex max-w-2xl flex-col gap-3 [&_code]:text-paper [&_button]:border-white/15 [&_button]:bg-white/10 [&_button]:text-paper/80 [&_button:hover]:bg-white/15 [&_button:hover]:text-paper [&_div]:border-white/15 [&_div]:bg-terminal">
      <CopyCommand command={install} />
      <CopyCommand command={test} />
    </div>
    <details class="mt-8 max-w-2xl text-sm text-paper/70">
      <summary class="cursor-pointer font-medium text-paper/80 hover:text-paper">
        Not on npm yet? Run from a clone
      </summary>
      <p class="mt-3 leading-relaxed">
        Build the monorepo once, then invoke the CLI from your app so <code class="font-mono text-paper/90">.storybranch/</code> is created there.
      </p>
      <div class="mt-4 flex flex-col gap-3 [&_code]:text-paper [&_button]:border-white/15 [&_button]:bg-white/10 [&_button]:text-paper/80 [&_button:hover]:bg-white/15 [&_button:hover]:text-paper [&_div]:border-white/15 [&_div]:bg-terminal">
        <CopyCommand command={setup} />
        <CopyCommand command={run} />
      </div>
    </details>
    <div class="mt-6 flex flex-wrap gap-4 text-sm font-medium">
      <a
        href={github}
        class="text-paper underline decoration-paper/30 underline-offset-4 transition-colors hover:decoration-paper"
        rel="noopener noreferrer"
        target="_blank"
      >
        GitHub repository
      </a>
      <a
        href="#agents"
        class="text-paper/70 underline decoration-paper/20 underline-offset-4 transition-colors hover:text-paper hover:decoration-paper/50"
      >
        Agent snippet
      </a>
      <a
        href={`${github}#readme`}
        class="text-paper/70 underline decoration-paper/20 underline-offset-4 transition-colors hover:text-paper hover:decoration-paper/50"
        rel="noopener noreferrer"
        target="_blank"
      >
        Full README
      </a>
    </div>
  </div>
</section>
