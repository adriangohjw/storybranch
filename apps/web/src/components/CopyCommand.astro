---
interface Props {
  command: string;
  class?: string;
}

const { command, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "group flex items-stretch overflow-hidden rounded-lg border border-ink/10 bg-surface shadow-sm",
    className,
  ]}
>
  <code
    class="flex-1 overflow-x-auto px-4 py-3 font-mono text-[13px] leading-relaxed text-ink sm:text-sm"
  >
    <span class="text-moss select-none">$</span>
    {" "}
    <span data-command>{command}</span>
  </code>
  <button
    type="button"
    class="shrink-0 border-l border-ink/10 bg-paper-2/60 px-4 text-xs font-semibold tracking-wide text-ink-muted transition-colors hover:bg-paper-2 hover:text-ink"
    data-copy
    aria-label="Copy install command"
  >
    Copy
  </button>
</div>

<script>
  function wireCopy(root: ParentNode = document) {
    for (const button of root.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      if (button.dataset.wired === "1") continue;
      button.dataset.wired = "1";
      button.addEventListener("click", async () => {
        const shell = button.closest("div");
        const command = shell?.querySelector("[data-command]")?.textContent?.trim();
        if (!command) return;
        try {
          await navigator.clipboard.writeText(command);
          const previous = button.textContent;
          button.textContent = "Copied";
          window.setTimeout(() => {
            button.textContent = previous;
          }, 1400);
        } catch {
          button.textContent = "Failed";
        }
      });
    }
  }

  wireCopy();
  document.addEventListener("astro:page-load", () => wireCopy());
</script>
