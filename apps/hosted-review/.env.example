STORYBRANCH_APP_URL=http://127.0.0.1:3000
STORYBRANCH_ADMIN_EMAIL=you@example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
DATABASE_URL=postgres://storybranch:storybranch@127.0.0.1:5432/storybranch
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=storybranch
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-minio
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
RESEND_API_KEY=
RESEND_FROM=storybranch <review@example.com>
# Non-prod only. Logs the message and does not call Resend. Do not set this in production.
STORYBRANCH_DANGEROUS_EMAIL_LOG=1
