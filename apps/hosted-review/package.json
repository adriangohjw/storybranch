{
  "name": "@storybranch/hosted-review",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "db:generate": "prisma generate && bun fmt src/generated/types.ts",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "dev": "prisma migrate deploy && vite dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "setup": "bash ./scripts/setup.sh",
    "start": "node .output/server/index.mjs",
    "test": "bun test --preload ./test/setup-env.ts",
    "typecheck": "bun ../../scripts/bun-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@fontsource/archivo": "catalog:",
    "@storybranch/mail": "workspace:*",
    "@storybranch/report": "workspace:*",
    "@storybranch/review-ui": "workspace:*",
    "@t3-oss/env-core": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "better-auth": "catalog:",
    "kysely": "catalog:",
    "nitro": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@storybranch/oxlint-config": "workspace:*",
    "@storybranch/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "dotenv": "catalog:",
    "prisma": "catalog:",
    "prisma-kysely": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  }
}
