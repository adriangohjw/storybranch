{
  "name": "@storybranch/hosted-review",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "db:generate": "prisma generate && bun fmt src/generated/types.ts",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "dev": "prisma migrate deploy && vite dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "setup": "bash ./scripts/setup.sh",
    "start": "node .output/server/index.mjs",
    "test": "bun test --preload ./test/setup-env.ts",
    "typecheck": "bun ../../scripts/bun-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:aws",
    "@fontsource-variable/inter": "^5.3.0",
    "@storybranch/mail": "workspace:*",
    "@storybranch/report": "workspace:*",
    "@storybranch/review-ui": "workspace:*",
    "@t3-oss/env-core": "catalog:t3",
    "@tanstack/react-router": "catalog:tanstack",
    "@tanstack/react-start": "catalog:tanstack",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "kysely": "catalog:prisma",
    "lucide-react": "^1.61.0",
    "nitro": "catalog:tanstack",
    "pg": "catalog:prisma",
    "radix-ui": "^1.8.1",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@storybranch/oxlint-config": "workspace:*",
    "@storybranch/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:tailwind",
    "@types/pg": "catalog:prisma",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitejs/plugin-react": "catalog:vite",
    "dotenv": "catalog:prisma",
    "prisma": "catalog:prisma",
    "prisma-kysely": "catalog:prisma",
    "tailwindcss": "catalog:tailwind",
    "vite": "catalog:vite"
  }
}
