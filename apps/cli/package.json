{
  "name": "storybranch",
  "version": "0.0.0",
  "bin": {
    "storybranch": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "bun test",
    "typecheck": "bun check",
    "prepack": "bun run --cwd ../../ build:review"
  },
  "dependencies": {
    "@storybranch/core": "workspace:*",
    "@storybranch/report": "workspace:*",
    "picocolors": "catalog:"
  },
  "devDependencies": {
    "@storybranch/oxfmt-config": "workspace:*",
    "@storybranch/oxlint-config": "workspace:*",
    "@storybranch/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "playwright": "catalog:",
    "ultracite": "catalog:"
  }
}
