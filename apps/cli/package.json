{
  "name": "@adriangohjw/storybranch",
  "version": "0.0.1",
  "description": "Local visual diffs for Storybook",
  "keywords": [
    "cli",
    "playwright",
    "storybook",
    "visual-regression",
    "visual-testing"
  ],
  "homepage": "https://storybranch.pages.dev",
  "bugs": {
    "url": "https://github.com/adriangohjw/storybranch/issues"
  },
  "license": "MIT",
  "author": "adriangohjw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adriangohjw/storybranch.git",
    "directory": "apps/cli"
  },
  "bin": {
    "storybranch": "./bin/storybranch.js"
  },
  "files": [
    "LICENSE",
    "bin/storybranch.js",
    "dist/addon",
    "dist/cli.js",
    "review/public"
  ],
  "type": "module",
  "exports": {
    "./addon": "./dist/addon/preset.js",
    "./addon/manager": "./dist/addon/manager.js",
    "./addon/preset": "./dist/addon/preset.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:cli && bun run build:addon",
    "build:addon": "bun build ./src/addon/preset.ts --outfile ./dist/addon/preset.js --target node --packages=external && bun build ./src/addon/manager.tsx --outfile ./dist/addon/manager.js --target browser --packages=external",
    "build:cli": "bun build ./src/cli.ts --outfile ./dist/cli.js --target node --external playwright --external picocolors --external pixelmatch --external pngjs --external ora --external log-update",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepublishOnly": "bun run build && bun test src/dependencies.test.ts src/help.test.ts src/review-spawn.test.ts",
    "prepack": "bun run --cwd ../review-ui build && bun run build && bun scripts/published-manifest.mjs",
    "postpack": "bun scripts/published-manifest.mjs restore",
    "test": "bun run build && bun test",
    "typecheck": "bun ../../scripts/bun-check.ts"
  },
  "dependencies": {
    "log-update": "catalog:",
    "ora": "catalog:",
    "picocolors": "catalog:",
    "pixelmatch": "catalog:",
    "playwright": "catalog:playwright",
    "pngjs": "catalog:png"
  },
  "devDependencies": {
    "@storybranch/core": "workspace:*",
    "@storybranch/oxlint-config": "workspace:*",
    "@storybranch/report": "workspace:*",
    "@storybranch/tsconfig": "workspace:*",
    "@types/bun": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
