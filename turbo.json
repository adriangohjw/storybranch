{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["BUN_CHECK_BIN", "STORYBRANCH_E2E_BROWSERS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".output/**",
        "../cli/review/public/**",
        "../../apps/cli/review/public/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "outputs": []
    },
    "format:fix": {
      "cache": false,
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
