{
  "name": "storybranch-repo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev:review": "turbo run dev --filter=@storybranch/review-ui",
    "format": "bun fmt --check .",
    "format:fix": "bun fmt",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "visual": "bun run --cwd packages/fixture visual",
    "visual:approve": "bun run --cwd packages/fixture visual:approve",
    "visual:review": "bun run --cwd packages/fixture visual:review",
    "pack:cli": "bun pm pack --cwd apps/cli",
    "publish:cli": "bun publish --cwd apps/cli",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@adriangohjw/storybranch": "workspace:*",
    "@storybook/react-vite": "catalog:storybook",
    "@types/bun": "catalog:",
    "@types/react": "catalog:react",
    "lefthook": "catalog:",
    "oxlint": "catalog:oxlint",
    "oxlint-plugin-react-doctor": "catalog:oxlint",
    "oxlint-tsgolint": "catalog:oxlint",
    "playwright": "catalog:playwright",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "storybook": "catalog:storybook",
    "turbo": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "@types/bun": "^1.4.3",
    "better-auth": "1.7.12",
    "lefthook": "^2.2.2",
    "log-update": "^8.0.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "turbo": "^2.5.8",
    "ultracite": "8.0.1",
    "zod": "^4.6.7"
  },
  "catalogs": {
    "astro": {
      "@astrojs/react": "^7.1.0",
      "astro": "^7.4.0"
    },
    "aws": {
      "@aws-sdk/client-s3": "^3.901.0"
    },
    "oxlint": {
      "oxlint": "^1.86.0",
      "oxlint-plugin-react-doctor": "^0.9.18",
      "oxlint-tsgolint": "^7.0.2004"
    },
    "playwright": {
      "playwright": "^1.64.1"
    },
    "png": {
      "@types/pngjs": "^6.0.5",
      "pixelmatch": "^8.0.0",
      "pngjs": "^7.0.0"
    },
    "prisma": {
      "@types/pg": "^8.15.5",
      "dotenv": "^18.0.9",
      "kysely": "^0.28.18",
      "pg": "^8.16.3",
      "prisma": "^7.10.1",
      "prisma-kysely": "^3.2.1"
    },
    "react": {
      "@fontsource/archivo": "^5.2.8",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react": "19",
      "react-dom": "19",
      "react-icons": "^5.5.0",
      "sonner": "^2.0.8"
    },
    "storybook": {
      "@storybook/react-vite": "10.6.2",
      "storybook": "10.6.2"
    },
    "t3": {
      "@t3-oss/env-core": "^0.13.11"
    },
    "tailwind": {
      "@tailwindcss/vite": "^4.1.13",
      "tailwind-merge": "^3.3.1",
      "tailwindcss": "^4.1.13"
    },
    "tanstack": {
      "@tanstack/react-router": "^1.170.46",
      "@tanstack/react-start": "^1.169.4",
      "nitro": "3.0.260903-beta"
    },
    "vite": {
      "@vitejs/plugin-react": "^6.1.2",
      "vite": "8"
    }
  },
  "patchedDependencies": {
    "react-docgen-typescript@2.4.0": "patches/react-docgen-typescript@2.4.0.patch"
  }
}
