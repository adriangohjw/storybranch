{
  "name": "storybranch",
  "version": "0.0.0",
  "bin": {
    "storybranch": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "bun check",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "bun test",
    "build:review": "vite build --config src/review/ui/vite.config.ts && touch src/review/public/.gitkeep",
    "dev:review": "vite --config src/review/ui/vite.config.ts",
    "prepack": "bun run build:review"
  },
  "dependencies": {
    "log-update": "^8.0.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/bun": "^1.4.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.86.0",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "oxlint-tsgolint": "^7.0.2004",
    "react": "19",
    "react-dom": "19",
    "storybook": "10.6.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "ultracite": "8.0.1",
    "vite": "8"
  },
  "packageManager": "bun@1.4.3",
  "patchedDependencies": {
    "react-docgen-typescript@2.4.0": "patches/react-docgen-typescript@2.4.0.patch"
  }
}
