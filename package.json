{
  "name": "storybranch",
  "version": "0.0.0",
  "bin": {
    "storybranch": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "bun check",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "bun test",
    "build:review": "bun run build:review:css && bun run build:review:js",
    "build:review:css": "tailwindcss -i ./src/review/source/styles.css -o ./src/review/public/styles.css --minify",
    "build:review:js": "bun build ./src/review/source/app.ts --outfile ./src/review/public/app.js --minify --target browser"
  },
  "dependencies": {
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "@storybook/react-vite": "10.6.1",
    "@types/bun": "^1.4.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2004",
    "react": "19",
    "react-dom": "19",
    "storybook": "10.6.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "ultracite": "8.0.1",
    "vite": "8"
  },
  "packageManager": "bun@1.4.3",
  "patchedDependencies": {
    "react-docgen-typescript@2.4.0": "patches/react-docgen-typescript@2.4.0.patch"
  }
}
