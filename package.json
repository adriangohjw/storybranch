{
  "name": "storybranch-repo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev:review": "turbo run dev --filter=@storybranch/review-ui",
    "format": "bun fmt --check .",
    "format:fix": "bun fmt",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "visual": "bun run --cwd packages/fixture visual",
    "visual:approve": "bun run --cwd packages/fixture visual:approve",
    "visual:review": "bun run --cwd packages/fixture visual:review",
    "pack:cli": "bun pm pack --cwd apps/cli",
    "publish:cli": "bun publish --cwd apps/cli",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@adriangohjw/storybranch": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "lefthook": "catalog:",
    "oxlint": "catalog:",
    "oxlint-plugin-react-doctor": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "turbo": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "@astrojs/react": "^7.1.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/bun": "^1.4.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "astro": "^7.4.0",
    "log-update": "^8.0.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "react": "19",
    "react-dom": "19",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "vite": "8",
    "oxlint": "^1.86.0",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "oxlint-tsgolint": "^7.0.2004",
    "lefthook": "^2.2.2",
    "ultracite": "8.0.1",
    "@storybook/react-vite": "10.6.1",
    "sonner": "^2.0.8",
    "storybook": "10.6.1",
    "turbo": "^2.5.8"
  },
  "patchedDependencies": {
    "react-docgen-typescript@2.4.0": "patches/react-docgen-typescript@2.4.0.patch"
  }
}
