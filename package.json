{
  "name": "storybranch-repo",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "build:review": "turbo run build --filter=@storybranch/review-ui",
    "dev:review": "turbo run dev --filter=@storybranch/review-ui",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "turbo run test --filter=storybranch"
  },
  "catalog": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/bun": "^1.4.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "log-update": "^8.0.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "react": "19",
    "react-dom": "19",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "vite": "8"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.1",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.86.0",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "10.6.1",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "ultracite": "8.0.1"
  },
  "packageManager": "bun@1.4.3",
  "patchedDependencies": {
    "react-docgen-typescript@2.4.0": "patches/react-docgen-typescript@2.4.0.patch"
  }
}
