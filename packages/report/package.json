{
  "name": "@storybranch/report",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/report.ts"
  },
  "scripts": {
    "format": "oxfmt --check src",
    "format:fix": "oxfmt src",
    "lint": "oxlint src/report.ts",
