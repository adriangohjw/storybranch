{
  "extends": "@storybranch/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist/types",
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": "src"
  },
  "references": [{ "path": "../report" }],
  "exclude": ["src/**/*.test.ts"],
  "include": ["./src/**/*.ts"]
}
