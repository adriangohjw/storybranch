{
  "name": "storybranch",
  "version": "0.0.0",
  "bin": {
    "storybranch": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt --check src",
    "format:fix": "oxfmt src",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "bun run --cwd ../../ build:review"
  },
  "dependencies": {
    "log-update": "catalog:",
    "ora": "catalog:",
    "picocolors": "catalog:",
    "pixelmatch": "catalog:",
    "playwright": "catalog:",
    "pngjs": "catalog:"
  },
  "devDependencies": {
    "@storybranch/tooling": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pngjs": "catalog:"
  }
}
